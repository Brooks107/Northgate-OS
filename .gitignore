# Local record of which command set was last pushed to Discord.
# Per-device, must never sync between machines.
.command-cache.json


# Environment files may contain secrets and must never be committed.
.env
.env.*

# Runtime lock flags, written by /cmdlock and other lock commands.
# Must stay untracked: a dirty working tree blocks git-sync's fast-forward.
state.json

# Feature request submissions contain private user-provided details.
feature-requests.json
feature-requests.json.*.tmp
